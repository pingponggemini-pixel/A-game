<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>⚔️ 官方回合制對戰 ⚔️</title>
    <style>
        body { background-color: #1a1a1a; color: white; font-family: sans-serif; text-align: center; padding: 20px; margin: 0; }
        .box { border: 2px solid #444; padding: 15px; margin: 10px auto; max-width: 400px; background: #2a2a2a; border-radius: 8px; }
        button { background: #0070f3; color: white; border: none; padding: 10px 20px; font-size: 16px; border-radius: 5px; cursor: pointer; margin: 5px; }
        button:hover { background: #0051a8; }
        .hp-bar { background: #555; width: 100%; height: 20px; border-radius: 10px; overflow: hidden; margin-top: 5px; }
        .hp-fill { background: #ff4d4d; height: 100%; width: 100%; transition: width 0.3s; }
        #log { font-style: italic; color: #aaa; min-height: 40px; margin-top: 15px; }
    </style>
</head>
<body>

    <h1>⚔️ 官方回合制對戰 ⚔️</h1>
    
    <div class="box">
        <h3>👿 邪惡首領</h3>
        <div class="hp-bar"><div id="boss-hp-bar" class="hp-fill"></div></div>
        <p>血量: <span id="boss-hp">100</span>/100</p>
    </div>

    <div class="box">
        <h3>🦸 傳奇勇者</h3>
        <div class="hp-bar"><div id="player-hp-bar" class="hp-fill" style="background:#00ea64;"></div></div>
        <p>血量: <span id="player-hp">100</span>/100</p>
    </div>

    <div class="box">
        <button onclick="attack()">⚔️ 普通攻擊</button>
        <button onclick="heavyAttack()">🔥 強力重擊</button>
        <button onclick="heal()">💖 治癒術</button>
        <div id="log">準備戰鬥！請下達指令。</div>
    </div>

    <script>
        let pHP = 100, bHP = 100;
        function updateUI() {
            document.getElementById('player-hp').innerText = pHP;
            document.getElementById('boss-hp').innerText = bHP;
            document.getElementById('player-hp-bar').style.width = pHP + '%';
            document.getElementById('boss-hp-bar').style.width = bHP + '%';
        }
        function attack() {
            if(pHP<=0 || bHP<=0) return;
            let dmg = 12; bHP = Math.max(0, bHP - dmg);
            document.getElementById('log').innerText = `你使出普通攻擊，對首領造成 ${dmg} 點傷害！`;
            if(bHP > 0) bossTurn(); else document.getElementById('log').innerText += " 🎉 你贏了！";
            updateUI();
        }
        function heavyAttack() {
            if(pHP<=0 || bHP<=0) return;
            let dmg = 25; bHP = Math.max(0, bHP - dmg);
            document.getElementById('log').innerText = `你蓄力重擊！對首領造成 ${dmg} 點巨大傷害！`;
            if(bHP > 0) bossTurn(); else document.getElementById('log').innerText += " 🎉 你贏了！";
            updateUI();
        }
        function heal() {
            if(pHP<=0 || bHP<=0) return;
            let amt = 20; pHP = Math.min(100, pHP + amt);
            document.getElementById('log').innerText = `你使用了治癒術，回復了 ${amt} 點血量！`;
            bossTurn();
            updateUI();
        }
        function bossTurn() {
            let dmg = 15; pHP = Math.max(0, pHP - dmg);
            document.getElementById('log').innerText += ` 👿 首領反擊，對你造成 ${dmg} 點傷害！`;
            if(pHP <= 0) document.getElementById('log').innerText = "💀 你被擊敗了... 遊戲結束。";
        }
    </script>
</body>
</html>
